# LLM Provider (Hyperspace via hai proxy)
# Base URL for OpenAI-compatible chat completions endpoint
LLM_BASE_URL=http://localhost:6655/litellm/v1/chat/completions
# API Key: if not set, falls back to ANTHROPIC_AUTH_TOKEN from hai proxy
# LLM_API_KEY=your-api-key-here

# Run Mode:
# - production (default): Real LLM API calls, local app runner
# - mock-full: Mock responses, writes to workspace/
# - mock-fast: Mock responses, uses pre-built mock-workspace/ (fastest)
# - demo: Mock responses, uses mock-workspace/, slower delays for presentations
# RUN_MODE=production
# RUN_MODE=mock-full
# RUN_MODE=mock-fast
# RUN_MODE=demo

# Server Port (default: 3000)
# PORT=3000

# GitHub OAuth App (for pushing generated apps to GitHub)
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here
