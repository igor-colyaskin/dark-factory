<mvc:View
	controllerName="com.sap.partner.wz.employee.directory.Main"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
>
	<VBox width="100%">
		<Table
			id="mainTable"
			fixedLayout="false"
			items="{tableModel>/items}"
			noDataText="{i18n>NO_DATA_TEXT}"
		>
			<headerToolbar>
				<OverflowToolbar id="headerToolbar">
					<Title id="tableTitle" text="{i18n>CARD_TITLE}" level="H4" />
					<ToolbarSpacer id="spacer" />
					<SearchField
						id="searchField"
						width="30%"
						placeholder="{i18n>SEARCH_PLACEHOLDER}"
						search=".onSearch"
						liveChange=".onSearch"
					/>
				</OverflowToolbar>
			</headerToolbar>

			<columns>
				<Column id="cId">
					<Text text="{i18n>EMPLOYEE_ID}" />
				</Column>
				<Column id="cFirst" minScreenWidth="Tablet" demandPopin="true">
					<Text text="{i18n>FIRST_NAME}" />
				</Column>
				<Column id="cLast" minScreenWidth="Tablet" demandPopin="true">
					<Text text="{i18n>LAST_NAME}" />
				</Column>
				<Column id="cDept">
					<Text text="{i18n>DEPARTMENT}" />
				</Column>
				<Column id="cPos" minScreenWidth="Desktop" demandPopin="true">
					<Text text="{i18n>POSITION}" />
				</Column>
				<Column id="cEmail" minScreenWidth="Desktop" demandPopin="true">
					<Text text="{i18n>EMAIL}" />
				</Column>
			</columns>

			<items>
				<ColumnListItem id="row">
					<cells>
						<Text text="{tableModel>employeeId}" />
						<Text text="{tableModel>firstName}" />
						<Text text="{tableModel>lastName}" />
						<Text text="{tableModel>department}" />
						<Text text="{tableModel>position}" />
						<Link text="{tableModel>email}" href="mailto:{tableModel>email}" />
					</cells>
				</ColumnListItem>
			</items>
		</Table>

		<core:Fragment
			id="paginationFrag"
			fragmentName="com.sap.partner.wz.employee.directory.fragments.Pagination"
			type="XML"
		/>
	</VBox>
</mvc:View>
